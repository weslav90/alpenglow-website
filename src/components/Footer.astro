---
import StitchDivider from './StitchDivider.astro';
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<StitchDivider />
	<div class="footer-content">
		<p class="logotype">{SITE_TITLE.replace(' Crafting Company', '')}</p>
		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/about">Our Story</a>
			<a href="/shop">Shop</a>
			<a href="/contact">Custom Order</a>
			<a href="mailto:orders@alpenglowcrafts.com">orders@alpenglowcrafts.com</a>
		</div>
		<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		background: var(--cream);
		padding: 2.5em 1em 3em 1em;
		text-align: center;
	}
	.footer-content {
		max-width: 960px;
		margin: 2rem auto 0 auto;
	}
	.footer-content .logotype {
		font-family: "Pinyon Script", cursive;
		font-size: 1.9rem;
		color: var(--rose);
		margin: 0 0 1rem 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.25em;
		margin-bottom: 1.25rem;
	}
	.footer-links a {
		color: var(--ink);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.footer-links a:hover {
		color: var(--rose);
	}
	.copyright {
		margin: 0;
		color: var(--peak);
		font-size: 0.8rem;
	}
</style>
