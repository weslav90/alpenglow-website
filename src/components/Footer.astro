---
import StitchDivider from './StitchDivider.astro';
import { SITE_TITLE, PICKUP_SHORT, INSTAGRAM_URL, FACEBOOK_URL } from '../consts';
const today = new Date();
---

<footer>
	<StitchDivider />
	<div class="footer-content">
		<p class="logotype">{SITE_TITLE.replace(' Crafting Company', '')}</p>
		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/about">Our Story</a>
			<a href="/shop">Shop</a>
			<a href="/gallery">Gallery</a>
			<a href="/contact">Custom Order</a>
			<a href="mailto:orders@alpenglowcrafts.com">orders@alpenglowcrafts.com</a>
		</div>
		<div class="footer-social">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Alpenglow on Instagram">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="18" height="18" rx="5" />
					<circle cx="12" cy="12" r="4" />
					<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
				</svg>
				<span>Instagram</span>
			</a>
			<a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Alpenglow on Facebook">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
					<path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z" />
				</svg>
				<span>Facebook</span>
			</a>
		</div>
		<p class="pickup-line">{PICKUP_SHORT}</p>
		<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		background: var(--cream);
		padding: 2.5em 1em 3em 1em;
		text-align: center;
	}
	.footer-content {
		max-width: 960px;
		margin: 2rem auto 0 auto;
	}
	.footer-content .logotype {
		font-family: "Pinyon Script", cursive;
		font-size: 1.9rem;
		color: var(--rose);
		margin: 0 0 1rem 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.25em;
		margin-bottom: 1.25rem;
	}
	.footer-links a {
		color: var(--ink);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.footer-links a:hover {
		color: var(--rose);
	}
	.footer-social {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1.25rem;
	}
	.footer-social a {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: var(--ink);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.footer-social a:hover {
		color: var(--rose);
	}
	.pickup-line {
		margin: 0 0 0.5rem 0;
		color: var(--ink);
		font-size: 0.85rem;
		font-weight: 600;
	}
	.copyright {
		margin: 0;
		color: var(--peak);
		font-size: 0.8rem;
	}
</style>
