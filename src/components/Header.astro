---
import HeaderLink from './HeaderLink.astro';
import StitchDivider from './StitchDivider.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a href="/" class="logotype">{SITE_TITLE.replace(' Crafting Company', '')}</a>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/about">Our Story</HeaderLink>
      <HeaderLink href="/shop">Shop</HeaderLink>
      <HeaderLink href="/contact" class="order-link">Custom Order</HeaderLink>
    </div>
  </nav>
  <StitchDivider />
</header>

<style>
  header {
    background: var(--cream);
    padding-top: 0.5em;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75em 1.5em 1em 1.5em;
    flex-wrap: wrap;
    gap: 0.75em;
  }
  .logotype {
    font-family: "Pinyon Script", cursive;
    font-size: 2.35rem;
    color: var(--rose);
    text-decoration: none;
    line-height: 1;
  }
  .internal-links {
    display: flex;
    gap: 0.5em;
    align-items: center;
    flex-wrap: wrap;
  }
  .internal-links :global(a) {
    padding: 0.5em 0.85em;
    color: var(--ink);
    text-decoration: none;
    font-family: "Manrope", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 999px;
  }
  .internal-links :global(a.active) {
    color: var(--rose);
    text-decoration: none;
    background: rgba(255, 45, 111, 0.08);
  }
  .internal-links :global(a.order-link) {
    background: var(--rose);
    color: white !important;
    font-weight: 700;
  }
  .internal-links :global(a.order-link:hover) {
    background: var(--violet);
  }
  @media (max-width: 640px) {
    nav {
      justify-content: center;
      text-align: center;
    }
  }
</style>
