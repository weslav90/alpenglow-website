---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <h2><a href="/">{SITE_TITLE}</a></h2>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/about">About Us</HeaderLink>
      <HeaderLink href="/blog">Gallery & Posts</HeaderLink>
      <HeaderLink href="/contact" class="order-link">Request an Order</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    border-bottom: 2px solid #F4A261;
  }
  h2 {
    margin: 0;
    font-size: 1.25em;
  }
  h2 a,
  h2 a.active {
    text-decoration: none;
    color: #E85D75;
    font-weight: 700;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1000px;
    margin: 0 auto;
    padding: 1em 0;
  }
  .internal-links {
    display: flex;
    gap: 1em;
    align-items: center;
  }
  a {
    padding: 0.5em 0.75em;
    color: #1E293B;
    border-bottom: 4px solid transparent;
    text-decoration: none;
    font-weight: 500;
  }
  a.active {
    text-decoration: none;
    border-bottom-color: #E85D75;
    color: #E85D75;
  }
  .order-link {
    background-color: #E85D75;
    color: white !important;
    border-radius: 20px;
    padding: 0.5em 1.2em;
    border-bottom: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .order-link:hover {
    background-color: #d04b62;
    transform: translateY(-1px);
  }
</style>