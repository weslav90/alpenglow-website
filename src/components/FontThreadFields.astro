---
// Reusable "Font Style" + "Thread Color" (+ optional accent color) picker.
// Used on the Shop page (per customizable product) and the custom-order
// Contact form, so every place customers personalize an order looks and
// behaves the same way.
import { FONT_CATEGORIES } from "../data/fonts";
import { THREAD_COLORS } from "../data/threadColors";

interface Props {
	/** Unique prefix so multiple pickers can live on one page (e.g. per product card). */
	idPrefix: string;
	/** Field name prefix used for form submission (contact form) — defaults to idPrefix. */
	namePrefix?: string;
	/** Whether Font Style + Thread Color are required fields. Default true. */
	required?: boolean;
}

const { idPrefix, namePrefix = idPrefix, required = true } = Astro.props;
---

<div class="ft-fields" data-ft-fields>
	<div class="ft-field">
		<label for={`${idPrefix}-font`}>Font Style {required && <span class="required">*</span>}</label>
		<div class="ft-color-row">
			<select id={`${idPrefix}-font`} name={`${namePrefix}_font_style`} required={required} data-ft-role="font">
				<option value="" disabled selected>Choose a font…</option>
				{
					FONT_CATEGORIES.map((cat) => (
						<optgroup label={cat.name}>
							{cat.fonts.map((f) => (
								<option value={f.name} data-img={f.image}>{f.name}</option>
							))}
						</optgroup>
					))
				}
			</select>
			<span class="ft-font-preview" data-ft-font-preview aria-hidden="true">
				<img alt="" />
			</span>
		</div>
	</div>

	<div class="ft-field">
		<label for={`${idPrefix}-thread`}>Thread Color {required && <span class="required">*</span>}</label>
		<div class="ft-color-row">
			<select id={`${idPrefix}-thread`} name={`${namePrefix}_thread_color`} required={required} data-ft-role="thread">
				<option value="" disabled selected>Choose a thread color…</option>
				{
					THREAD_COLORS.map((c) => (
						<option value={`${c.code} ${c.name}`} data-hex={c.hex}>
							{c.code} — {c.name}
						</option>
					))
				}
			</select>
			<span class="ft-swatch" data-ft-swatch aria-hidden="true"></span>
		</div>
	</div>

	<div class="ft-field">
		<label for={`${idPrefix}-accent`}>
			Accent Thread Color <span class="optional">(optional — for two-tone monogram styles)</span>
		</label>
		<div class="ft-color-row">
			<select id={`${idPrefix}-accent`} name={`${namePrefix}_accent_thread_color`} data-ft-role="accent">
				<option value="" selected>None</option>
				{
					THREAD_COLORS.map((c) => (
						<option value={`${c.code} ${c.name}`} data-hex={c.hex}>
							{c.code} — {c.name}
						</option>
					))
				}
			</select>
			<span class="ft-swatch" data-ft-swatch aria-hidden="true"></span>
		</div>
	</div>
</div>

<style>
	.ft-fields {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.ft-field label {
		display: block;
		font-size: 0.85rem;
		font-weight: 700;
		margin-bottom: 0.35rem;
		font-family: "Manrope", sans-serif;
	}
	.ft-field .required {
		color: var(--rose);
	}
	.ft-field .optional {
		font-weight: 400;
		color: var(--peak);
	}
	.ft-field select {
		width: 100%;
		padding: 0.65rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		box-sizing: border-box;
		font-family: inherit;
		background: var(--card);
		color: var(--ink);
	}
	.ft-field select:focus {
		outline: 2px solid var(--violet);
		outline-offset: 1px;
	}
	.ft-color-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.ft-color-row select {
		flex: 1;
	}
	.ft-swatch {
		flex-shrink: 0;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: repeating-linear-gradient(
			45deg,
			#f0f0f0,
			#f0f0f0 4px,
			#ffffff 4px,
			#ffffff 8px
		);
	}
	.ft-font-preview {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 5.5rem;
		height: 2.6rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: #ffffff;
		overflow: hidden;
		padding: 0.25rem;
		box-sizing: border-box;
	}
	.ft-font-preview img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		display: none;
	}
	.ft-font-preview img[src] {
		display: block;
	}
</style>

<script>
	// Update each color swatch preview whenever its <select> changes, and
	// keep it in sync on initial load (e.g. back/forward navigation).
	function initSwatches(root: ParentNode) {
		root.querySelectorAll<HTMLSelectElement>("select[data-ft-role='thread'], select[data-ft-role='accent']").forEach((select) => {
			const row = select.closest(".ft-color-row");
			const swatch = row?.querySelector<HTMLElement>("[data-ft-swatch]");
			if (!swatch) return;
			const apply = () => {
				const opt = select.selectedOptions[0];
				const hex = opt?.dataset.hex;
				if (hex) {
					swatch.style.background = hex;
				} else {
					swatch.style.background =
						"repeating-linear-gradient(45deg, #f0f0f0, #f0f0f0 4px, #ffffff 4px, #ffffff 8px)";
				}
			};
			select.addEventListener("change", apply);
			// A successful submit calls form.reset(), which clears the <select>
			// without firing "change" — repaint after the reset lands so the
			// swatch doesn't keep showing the previous order's color.
			select.form?.addEventListener("reset", () => setTimeout(apply, 0));
			apply();
		});
	}
	initSwatches(document);

	// Same idea for the Font Style picker: show a small sample image of the
	// selected font next to the dropdown, the way the thread swatch shows a
	// color preview.
	function initFontPreviews(root: ParentNode) {
		root.querySelectorAll<HTMLSelectElement>("select[data-ft-role='font']").forEach((select) => {
			const row = select.closest(".ft-color-row");
			const img = row?.querySelector<HTMLImageElement>("[data-ft-font-preview] img");
			if (!img) return;
			const apply = () => {
				const opt = select.selectedOptions[0];
				const src = opt?.dataset.img;
				if (src) {
					img.src = src;
					img.alt = `Preview of the ${opt.textContent} font`;
				} else {
					img.removeAttribute("src");
					img.alt = "";
				}
			};
			select.addEventListener("change", apply);
			select.form?.addEventListener("reset", () => setTimeout(apply, 0));
			apply();
		});
	}
	initFontPreviews(document);
</script>
