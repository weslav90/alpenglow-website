---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { products } from '../data/products';

const featured = products.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-content">
          <span class="eyebrow">Custom Embroidery &amp; Sewing</span>
          <h1>Warmth &amp; art in every stitch.</h1>
          <p class="lede">
            Inspired by the rose-and-gold light that catches mountain peaks at dawn,
            we stitch custom monograms, apparel, and keepsakes built to be kept.
          </p>
          <div class="hero-buttons">
            <a href="/shop" class="btn btn-primary">Shop Ready-Made</a>
            <a href="/contact" class="btn btn-secondary">Start a Custom Order</a>
          </div>
        </div>
      </section>

      <StitchDivider />

      <!-- What we make -->
      <section class="section">
        <h2>What we create</h2>
        <div class="grid">
          <div class="card">
            <h3>Custom Embroidery</h3>
            <p>Monogrammed gifts, personalized apparel, and detailed fabric art designed to last.</p>
          </div>
          <!--
          <div class="card">
            <h3>Bespoke Sewing</h3>
            <p>Handmade tote bags, home decor, and custom fabric crafts tailored to your vision.</p>
          </div>
          <div class="card">
            <h3>Alpine-Inspired Gifts</h3>
            <p>Crafted with the warmth and color of mountain living — made to be given, not just bought.</p>
          </div>
          -->
        </div>
      </section>

      <StitchDivider />

      <!-- Featured products -->
      <section class="section">
        <h2>Ready to order today</h2>
        <p class="section-sub">No custom quote needed — pick, personalize, and check out.</p>
        <div class="grid products-grid">
          {featured.map((product) => (
            <a href="/shop" class="product-card">
              <img src={product.image} alt={product.name} />
              <h3>{product.name}</h3>
              <p class="price">{product.price}</p>
            </a>
          ))}
        </div>
        <div class="shop-cta">
          <a href="/shop" class="btn btn-secondary">See the full shop</a>
        </div>
      </section>

      <StitchDivider />

      <!-- Story teaser -->
      <section class="section story-teaser">
        <div>
          <span class="eyebrow">Our Story</span>
          <h2>Stitched by hand, started with family.</h2>
          <p>
            Alpenglow Crafting Company began at our own kitchen table — read about how it started,
            and the hands behind every stitch.
          </p>
          <a href="/about" class="btn btn-primary">Meet the Maker</a>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      .hero {
        position: relative;
        text-align: center;
        padding: 5rem 1.5rem 4rem 1.5rem;
        overflow: hidden;
      }
      .hero-glow {
        position: absolute;
        inset: -20% -10% auto -10%;
        height: 420px;
        background: var(--alpenglow-gradient);
        opacity: 0.16;
        filter: blur(60px);
        z-index: 0;
      }
      .hero-content {
        position: relative;
        z-index: 1;
        max-width: 720px;
        margin: 0 auto;
      }
      .lede {
        font-size: 1.2rem;
        color: var(--peak);
        max-width: 560px;
        margin: 0 auto 2rem auto;
      }
      .hero-buttons {
        display: flex;
        gap: 1em;
        justify-content: center;
        flex-wrap: wrap;
      }
      .section h2 {
        text-align: center;
      }
      .section-sub {
        text-align: center;
        color: var(--peak);
        margin-top: -0.5rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5em;
        margin-top: 2.5rem;
      }
      .card h3 {
        color: var(--rose);
      }
      .card p {
        color: var(--peak);
        font-size: 0.95rem;
      }
      .product-card {
        display: block;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem;
        text-align: center;
        text-decoration: none;
        box-shadow: var(--shadow-card);
        transition: transform 0.15s ease;
      }
      .product-card:hover {
        transform: translateY(-4px);
      }
      .product-card h3 {
        font-size: 1.1rem;
        margin: 0.75em 0 0.25em 0;
        color: var(--ink);
      }
      .product-card .price {
        color: var(--rose);
        font-weight: 700;
        margin: 0;
      }
      .shop-cta {
        text-align: center;
        margin-top: 2.5rem;
      }
      .story-teaser {
        text-align: center;
      }
      .story-teaser p {
        max-width: 560px;
        margin: 0 auto 1.5rem auto;
        color: var(--peak);
      }
    </style>
  </body>
</html>
