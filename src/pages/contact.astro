---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Order Request | ${SITE_TITLE}`} description="Submit a custom embroidery or sewing request." />
  </head>
  <body>
    <Header />
    <main class="contact-container">
      <div class="contact-header">
        <h1>Custom Order Request</h1>
        <p>
          Have a custom sewing or embroidery project in mind? Fill out the form below with your project details, and we’ll respond with a quote within 24–48 hours.
        </p>
      </div>

      <div class="contact-wrapper">
        <aside class="contact-info">
          <h3>Get in Touch</h3>
          <p>We love turning custom ideas into reality.</p>
          
          <div class="info-item">
            <strong>Direct Email:</strong>
            <a href="mailto:orders@alpenglowcrafts.com">orders@alpenglowcrafts.com</a>
          </div>

          <div class="info-item">
            <strong>Turnaround Time:</strong>
            <p>1–2 Business Days for Quotes</p>
          </div>

          <div class="info-notice">
            <p>💡 <em>Tip: Include dimensions, thread/fabric colors, or target dates in your message!</em></p>
          </div>
        </aside>

        <div class="form-card">
          <form id="contact-form">
            <input type="hidden" name="access_key" value={web3formsKey} />
            <input type="hidden" name="subject" value="New Craft Order Request - Alpenglow Crafts" />
            <input type="checkbox" name="botcheck" id="botcheck" style="display: none;" />

            <div class="form-group">
              <label for="name">Your Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Jane Doe" />
            </div>

            <div class="form-group">
              <label for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>

            <div class="form-group">
              <label for="project_type">Project Type</label>
              <select id="project_type" name="project_type">
                <option value="Custom Embroidery">Custom Embroidery / Monogram</option>
                <option value="Custom Sewing">Custom Sewing Craft</option>
                <option value="Apparel / Patch">Apparel / Fabric Patch</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Project Details <span class="required">*</span></label>
              <textarea id="message" name="message" rows="5" required placeholder="Describe what you'd like created..."></textarea>
            </div>

            <button type="submit" id="submit-btn" class="submit-btn">Send Order Request</button>
            <div id="result" class="result-message"></div>
          </form>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const result = document.getElementById('result') as HTMLElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      if (form && result && submitBtn) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerText = "Sending...";
          result.style.display = "block";
          result.className = "result-message pending";
          result.innerText = "Submitting your request...";

          const formData = new FormData(form);
          const json = JSON.stringify(Object.fromEntries(formData));

          try {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: json
            });
            const jsonResponse = await response.json();

            if (response.status === 200) {
              result.className = "result-message success";
              result.innerText = "Thank you! Your request has been sent. We'll be in touch soon.";
              form.reset();
            } else {
              result.className = "result-message error";
              result.innerText = jsonResponse.message || "Something went wrong. Please try again.";
            }
          } catch (error) {
            result.className = "result-message error";
            result.innerText = "Network error. Please try again.";
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = "Send Order Request";
          }
        });
      }
    </script>

    <style>
      body { background-color: #FAF8F5; color: #1E293B; }
      .contact-container { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
      .contact-header { text-align: center; margin-bottom: 2.5rem; }
      .contact-header h1 { font-size: 2.25rem; color: #E85D75; margin-bottom: 0.5rem; }
      .contact-wrapper { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
      @media (max-width: 768px) { .contact-wrapper { grid-template-columns: 1fr; } }
      .contact-info { background: white; padding: 1.75rem; border-radius: 8px; border: 1px solid #e2e8f0; height: fit-content; }
      .contact-info h3 { color: #E85D75; margin-top: 0; }
      .info-item { margin-top: 1.25rem; }
      .info-item a { color: #E85D75; text-decoration: none; font-weight: 500; }
      .info-notice { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #e2e8f0; font-size: 0.875rem; color: #64748B; }
      .form-card { background: white; padding: 2rem; border-radius: 8px; border: 1px solid #e2e8f0; }
      .form-group { margin-bottom: 1.25rem; }
      .form-group label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.375rem; }
      .required { color: #e53e3e; }
      .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
      .submit-btn { width: 100%; background-color: #E85D75; color: white; border: none; padding: 0.875rem; font-size: 1rem; font-weight: 600; border-radius: 6px; cursor: pointer; }
      .submit-btn:hover { background-color: #d04b62; }
      .result-message { display: none; margin-top: 1rem; padding: 0.875rem; border-radius: 6px; font-size: 0.875rem; text-align: center; }
      .result-message.pending { background-color: #ebf8ff; color: #2b6cb0; }
      .result-message.success { background-color: #f0fff4; color: #276749; border: 1px solid #c6f6d5; }
      .result-message.error { background-color: #fff5f5; color: #9b2c2c; border: 1px solid #fed7d7; }
    </style>
  </body>
</html>