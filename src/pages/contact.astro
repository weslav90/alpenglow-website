---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import FontThreadFields from '../components/FontThreadFields.astro';
import { SITE_TITLE } from '../consts';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "1936cfc5-4f93-4fcf-9714-a9957d73f0a4";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Custom Order | ${SITE_TITLE}`} description="Submit a custom embroidery request." />
  </head>
  <body>
    <Header />
    <main class="contact-container">
      <div class="contact-header">
        <span class="eyebrow">Custom Order</span>
        <h1>Tell us what you're picturing</h1>
        <p>
          Have a custom embroidery project in mind? Fill out the form below with your project details, and we'll respond with a quote within 24–48 hours.
        </p>
      </div>

      <StitchDivider compact />

      <div class="contact-wrapper">
        <aside class="contact-info">
          <h3>Get in Touch</h3>
          <p>We love turning custom ideas into reality.</p>

          <div class="info-item">
            <strong>Direct Email:</strong>
            <a href="mailto:orders@alpenglowcrafts.com">orders@alpenglowcrafts.com</a>
          </div>

          <div class="info-item">
            <strong>Turnaround Time:</strong>
            <p>1–2 Business Days for Quotes</p>
          </div>

          <div class="info-notice">
            <p>💡 <em>Tip: Include dimensions, thread/fabric colors, or target dates in your message!</em></p>
          </div>
        </aside>

        <div class="form-card">
          <form id="contact-form">
            <input type="hidden" name="access_key" value={web3formsKey} />
            <!-- Replaced at submit time with a per-order summary; see the script below. -->
            <input type="hidden" name="subject" value="New Custom Order" />
            <input type="hidden" name="order_type" value="Custom Order" />
            <input type="hidden" name="next_step" value="Waiting Invoice Response" />
            <input type="checkbox" name="botcheck" id="botcheck" style="display: none;" />

            <div class="form-group">
              <label for="name">Your Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Jane Doe" />
            </div>

            <div class="form-group">
              <label for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>

            <div class="form-group">
              <label for="project_type">Project Type</label>
              <select id="project_type" name="project_type">
                <option value="Custom Embroidery">Custom Embroidery / Monogram</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <p class="options-intro">
                Already know what you want? Pick a font and thread color — browse the
                <a href="/#fonts">font guide</a> and <a href="/#threads">thread colors</a> if you'd
                like to see them first. Not sure yet? Skip this and just describe it below.
              </p>
              <FontThreadFields idPrefix="contact" namePrefix="contact" required={false} />
            </div>

            <div class="form-group">
              <label for="message">Project Details <span class="required">*</span></label>
              <textarea id="message" name="message" rows="5" required placeholder="Describe what you'd like created..."></textarea>
            </div>

            <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">Send Order Request</button>
            <div id="result" class="result-message"></div>
          </form>
        </div>
      </div>
    </main>
    <Footer />

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement;
      const result = document.getElementById('result') as HTMLElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

      if (form && result && submitBtn) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerText = "Sending...";
          result.style.display = "block";
          result.className = "result-message pending";
          result.innerText = "Submitting your request...";

          const formData = new FormData(form);

          // See custom-hat.astro — the subject carries the order summary so a
          // Trello card title can map straight from it instead of parsing the
          // email body. Keep the "New Custom Order" prefix stable for filters.
          // Stays ASCII: the subject becomes an email header, and non-ASCII
          // there has to be MIME-encoded to survive the hop to the mailbox.
          // Control chars go too - a newline in a header is an injection vector.
          const tidy = (value: FormDataEntryValue | null, max: number) =>
            String(value ?? '')
              .replace(/[\x00-\x1F\x7F]/g, ' ')
              .replace(/\s+/g, ' ')
              .trim()
              .slice(0, max);

          const customer = tidy(formData.get('name'), 40);
          const projectType = tidy(formData.get('project_type'), 40);

          const summary = [customer, projectType].filter(Boolean).join(' - ');
          formData.set('subject', summary ? `New Custom Order - ${summary}` : 'New Custom Order');

          const json = JSON.stringify(Object.fromEntries(formData));

          try {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: json
            });
            const jsonResponse = await response.json();

            // Web3Forms answers HTTP 200 with {"success": false} when it
            // rejects a submission, so the status alone is not enough - going
            // by it reports a rejected order to the customer as sent.
            if (response.ok && jsonResponse.success !== false) {
              result.className = "result-message success";
              result.innerText = "Thank you! Your request has been sent. We'll be in touch soon.";
              form.reset();
            } else {
              console.error('Web3Forms rejected the submission', response.status, jsonResponse);
              result.className = "result-message error";
              result.innerText = jsonResponse.message
                ? `Couldn't send: ${jsonResponse.message}`
                : "Something went wrong. Please email orders@alpenglowcrafts.com.";
            }
          } catch (error) {
            console.error('Web3Forms request failed', error);
            result.className = "result-message error";
            result.innerText = "Network error. Please try again, or email orders@alpenglowcrafts.com.";
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = "Send Order Request";
          }
        });
      }
    </script>

    <style>
      .contact-container { max-width: 1000px; margin: 0 auto; padding: 3rem 1.5rem; }
      .contact-header { text-align: center; margin-bottom: 1.5rem; }
      .contact-header h1 { color: var(--ink); }
      .contact-header p { max-width: 560px; margin: 0 auto; color: var(--peak); }
      .contact-wrapper { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; margin-top: 2.5rem; }
      @media (max-width: 768px) { .contact-wrapper { grid-template-columns: 1fr; } }
      .contact-info { background: var(--card); padding: 1.75rem; border-radius: 16px; border: 1px solid var(--border); height: fit-content; box-shadow: var(--shadow-card); }
      .contact-info h3 { color: var(--rose); margin-top: 0; }
      .info-item { margin-top: 1.25rem; }
      .info-item a { color: var(--rose); text-decoration: none; font-weight: 500; }
      .info-notice { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.875rem; color: var(--peak); }
      .form-card { background: var(--card); padding: 2rem; border-radius: 16px; border: 1px solid var(--border); box-shadow: var(--shadow-card); }
      .form-group { margin-bottom: 1.25rem; }
      .form-group label { display: block; font-size: 0.875rem; font-weight: 700; margin-bottom: 0.375rem; font-family: "Manrope", sans-serif; }
      .required { color: var(--rose); }
      .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; box-sizing: border-box; font-family: inherit; }
      .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: 2px solid var(--violet); outline-offset: 1px; }
      .options-intro { font-size: 0.85rem; color: var(--peak); margin: 0 0 0.85rem 0; }
      .options-intro a { color: var(--rose); font-weight: 600; text-decoration: none; }
      .submit-btn { width: 100%; text-align: center; border: none; font-size: 1rem; }
      .result-message { display: none; margin-top: 1rem; padding: 0.875rem; border-radius: 8px; font-size: 0.875rem; text-align: center; }
      .result-message.pending { background-color: #fdf0e8; color: var(--coral); }
      .result-message.success { background-color: #f0fff4; color: #276749; border: 1px solid #c6f6d5; }
      .result-message.error { background-color: #fff5f5; color: #9b2c2c; border: 1px solid #fed7d7; }
    </style>
  </body>
</html>
