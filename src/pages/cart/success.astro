---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Order Confirmed | ${SITE_TITLE}`} description="Thank you for your order." />
  </head>
  <body>
    <Header />
    <main>
      <section class="section confirmation">
        <span class="eyebrow">Thank You</span>
        <h1>Your order is confirmed</h1>
        <p class="lede">
          Stripe has processed your payment and a receipt is on its way to your email. We'll
          begin stitching your order shortly.
        </p>
        <a href="/shop" class="btn btn-primary">Continue Shopping</a>
      </section>
    </main>
    <Footer />

    <script>
      import { clearCart } from '../../lib/cart';

      // A successful redirect here means Stripe accepted the payment for
      // everything in the cart at checkout time, so it's safe to empty it.
      clearCart();
    </script>

    <style>
      .confirmation {
        text-align: center;
        padding: 4rem 1.5rem;
        max-width: 560px;
        margin: 0 auto;
      }
      .confirmation .lede {
        color: var(--peak);
        margin-bottom: 2rem;
      }
    </style>
  </body>
</html>
