---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import FontThreadFields from '../components/FontThreadFields.astro';
import { SITE_TITLE } from '../consts';
import { products } from '../data/products';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Shop | ${SITE_TITLE}`}
      description="Ready-made embroidered goods you can order today, no custom quote needed."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section intro">
        <span class="eyebrow">Ready-Made</span>
        <h1>Shop our ready-to-order pieces</h1>
        <p class="lede">
          Looking for something custom instead? Head to our
          <a href="/contact">custom order page</a> to get a quote.
        </p>
      </section>

      <StitchDivider />

      <section class="section">
        <div class="grid">
          {products.map((product, i) => (
            <div class="product">
              <img src={product.image} alt={product.name} />
              <div class="product-body">
                <h3>{product.name}</h3>
                <p class="description">{product.description}</p>

                {product.customizable && (
                  <div class="product-options">
                    <FontThreadFields idPrefix={`product-${i}`} />
                  </div>
                )}

                <div class="product-footer">
                  <span class="price">{product.price}</span>
                  {product.customizable ? (
                    <a
                      href="#"
                      class="btn btn-primary buy-btn is-disabled"
                      aria-disabled="true"
                      data-buy-link
                      data-base-href={product.paymentLink}
                      data-product-options={`product-${i}`}
                    >
                      Buy Now
                    </a>
                  ) : (
                    <a href={product.paymentLink} class="btn btn-primary buy-btn">Buy Now</a>
                  )}
                </div>
                {product.customizable && (
                  <p class="options-hint" data-options-hint={`product-${i}`}>
                    Choose a font and thread color to continue.
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
    <Footer />

    <style>
      .intro {
        text-align: center;
      }
      .intro .lede {
        color: var(--peak);
        max-width: 560px;
        margin: 0 auto;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
      .product {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
      }
      .product img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0;
        display: block;
      }
      .product-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .product-body h3 {
        margin-bottom: 0.4em;
      }
      .description {
        color: var(--peak);
        font-size: 0.95rem;
        flex-grow: 1;
      }
      .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1rem;
      }
      .price {
        font-family: "Fraunces", serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--rose);
      }
      .buy-btn {
        padding: 0.6em 1.4em;
        font-size: 0.9rem;
      }
      .buy-btn.is-disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
      }
      .product-options {
        margin: 1.25rem 0;
        padding: 1.25rem;
        background: var(--cream);
        border: 1px solid var(--border);
        border-radius: 12px;
      }
      .options-hint {
        margin: 0.6rem 0 0 0;
        font-size: 0.8rem;
        color: var(--peak);
        text-align: right;
      }
      .options-hint.is-ready {
        display: none;
      }
    </style>

    <script>
      // Require a font + thread color pick before "Buy Now" is usable, then
      // carry the pick into Stripe via the client_reference_id URL param so
      // it's attached to the payment (visible in the Stripe Dashboard).
      // client_reference_id only accepts letters, numbers, dashes and
      // underscores — anything else is silently dropped by Stripe.
      function slugify(value: string) {
        return value.replace(/[^a-zA-Z0-9]+/g, "");
      }

      document.querySelectorAll<HTMLAnchorElement>("[data-buy-link]").forEach((link) => {
        const optionsId = link.dataset.productOptions;
        const baseHref = link.dataset.baseHref;
        if (!optionsId || !baseHref) return;

        const fontSelect = document.getElementById(`${optionsId}-font`) as HTMLSelectElement | null;
        const threadSelect = document.getElementById(`${optionsId}-thread`) as HTMLSelectElement | null;
        const accentSelect = document.getElementById(`${optionsId}-accent`) as HTMLSelectElement | null;
        const hint = document.querySelector(`[data-options-hint="${optionsId}"]`);
        if (!fontSelect || !threadSelect) return;

        const update = () => {
          const font = fontSelect.value;
          const thread = threadSelect.value;
          const accent = accentSelect?.value;
          const ready = Boolean(font && thread);

          if (ready) {
            const parts = [`FONT_${slugify(font)}`, `THREAD_${slugify(thread)}`];
            if (accent) parts.push(`ACCENT_${slugify(accent)}`);
            const ref = parts.join("-").slice(0, 200);
            link.href = `${baseHref}?client_reference_id=${encodeURIComponent(ref)}`;
            link.classList.remove("is-disabled");
            link.removeAttribute("aria-disabled");
            hint?.classList.add("is-ready");
          } else {
            link.href = "#";
            link.classList.add("is-disabled");
            link.setAttribute("aria-disabled", "true");
            hint?.classList.remove("is-ready");
          }
        };

        fontSelect.addEventListener("change", update);
        threadSelect.addEventListener("change", update);
        accentSelect?.addEventListener("change", update);
        update();
      });
    </script>
  </body>
</html>
