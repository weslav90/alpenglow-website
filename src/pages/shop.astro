---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import { SITE_TITLE } from '../consts';
import { products } from '../data/products';

const readyToOrder = products.filter((product) => product.priceId || product.variants);
const customEmbroidery = products.filter((product) => product.customOrderHref);

// Unique per-product id prefix for personalization field <label for>/id pairs, since several
// product cards with their own fields render on this one page.
function slugify(name: string): string {
	return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Shop | ${SITE_TITLE}`}
      description="Ready-made embroidered goods you can order today, plus made-to-order pieces stitched with your own text."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section intro">
        <span class="eyebrow">Shop</span>
        <h1>Ready to order</h1>
        <p class="lede">
          Buy a finished piece as pictured, or design your own with the font and thread color of
          your choice. Looking for something else entirely? Start a
          <a href="/contact">custom order</a>.
        </p>
      </section>

      <StitchDivider />

      <section class="section">
        <div class="grid">
          {readyToOrder.map((product) => (
            <div class="product">
              <img src={product.image} alt={product.name} />
              <div class="product-body">
                <h3>{product.name}</h3>
                <p class="description">{product.description}</p>
                {product.personalization && (
                  <div class="personalize-fields">
                    {product.personalization.map((field) => (
                      <div
                        class="form-group personalize-field"
                        data-personalize-field
                        data-show-for-variants={field.showForVariants?.join(',') ?? ''}
                        data-show-when-key={field.showWhen?.key ?? ''}
                        data-show-when-equals={field.showWhen?.equals ?? ''}
                      >
                        <label for={`${slugify(product.name)}-${field.key}`}>
                          {field.label} <span class="required">*</span>
                        </label>
                        {field.type === 'select' ? (
                          <div class="personalize-color-row">
                            <select
                              id={`${slugify(product.name)}-${field.key}`}
                              data-personalize-input={field.key}
                              data-personalize-label={field.label}
                            >
                              <option value="" disabled selected>Choose…</option>
                              {field.options?.map((opt) => (
                                <option value={opt.value} data-hex={opt.hex}>{opt.label}</option>
                              ))}
                            </select>
                            {field.options?.some((opt) => opt.hex) && (
                              <span class="personalize-swatch" data-personalize-swatch aria-hidden="true"></span>
                            )}
                          </div>
                        ) : (
                          <input
                            type="text"
                            id={`${slugify(product.name)}-${field.key}`}
                            data-personalize-input={field.key}
                            data-personalize-label={field.label}
                            maxlength="60"
                            placeholder={field.label}
                          />
                        )}
                      </div>
                    ))}
                  </div>
                )}
                <div class="product-footer">
                  {product.variants ? (
                    <select class="variant-select" data-variant-select aria-label={`Choose an option for ${product.name}`}>
                      {product.variants.map((variant) => (
                        <option value={variant.priceId} data-price={variant.price} data-label={variant.label}>
                          {variant.label} — {variant.price}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <span class="price">{product.price}</span>
                  )}
                  <button
                    type="button"
                    class="btn btn-primary buy-btn add-to-cart-btn"
                    data-add-to-cart
                    data-price-id={product.priceId}
                    data-name={product.name}
                    data-price={product.price}
                    data-image={product.image}
                    data-variant-product={product.variants ? '' : undefined}
                  >
                    {product.ctaLabel ?? 'Add to Cart'}
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <StitchDivider />

      <section class="section custom-section">
        <span class="eyebrow">Made to Order</span>
        <h2>Custom Embroidery</h2>
        <p class="lede">
          Have your own item to embroider, or want something stitched from scratch? Choose your
          font and thread color, tell us what you'd like, and we'll send you a quote before
          anything is charged.
        </p>
        <div class="grid">
          {customEmbroidery.map((product) => (
            <div class="product">
              <img src={product.image} alt={product.name} />
              <div class="product-body">
                <h3>{product.name}</h3>
                <p class="description">{product.description}</p>
                <p class="quote-note">Quoted before you pay — no charge until you approve.</p>
                <div class="product-footer">
                  <span class="price">{product.price}</span>
                  <a href={product.customOrderHref} class="btn btn-primary buy-btn">
                    {product.ctaLabel ?? 'Design Yours'}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
    <Footer />

    <script>
      import { addItem } from '../lib/cart';

      type PersonalizeInput = HTMLInputElement | HTMLSelectElement;

      // Updates a select's color swatch (Name Tags' Border Color, etc.) to the hex on its
      // currently selected option, or back to the CSS-default checkerboard placeholder.
      function updateSwatch(select: HTMLSelectElement) {
        const swatch = select.closest('.personalize-color-row')?.querySelector<HTMLElement>('[data-personalize-swatch]');
        if (!swatch) return;
        swatch.style.background = select.selectedOptions[0]?.dataset.hex || '';
      }

      // Personalization fields can be scoped to one variant (the Name Tags phone number) or to
      // a sibling field's value (the socks' custom-icon description only once "Custom" is
      // picked). Re-check every field's visibility/required-ness and refresh color swatches
      // whenever anything on the card changes, and once up front on load.
      function syncPersonalizeCard(card: Element) {
        const variantSelect = card.querySelector<HTMLSelectElement>('[data-variant-select]');
        const currentVariant = variantSelect?.value ?? '';

        card.querySelectorAll<HTMLElement>('[data-personalize-field]').forEach((field) => {
          const showFor = field.dataset.showForVariants;
          let applies = !showFor || showFor.split(',').includes(currentVariant);

          const showWhenKey = field.dataset.showWhenKey;
          if (applies && showWhenKey) {
            const sibling = card.querySelector<PersonalizeInput>(
              `[data-personalize-input="${showWhenKey}"]`,
            );
            applies = sibling?.value === field.dataset.showWhenEquals;
          }

          field.hidden = !applies;
          const input = field.querySelector<PersonalizeInput>('[data-personalize-input]');
          if (input) input.required = applies;
        });

        card
          .querySelectorAll<HTMLSelectElement>('select[data-personalize-input]')
          .forEach(updateSwatch);
      }

      document.querySelectorAll('.product').forEach((card) => {
        syncPersonalizeCard(card);
        // Delegated so it covers the variant select and every personalization field (including
        // ones that gate each other, like the socks' Icon -> custom-icon-description field) with
        // one listener per card instead of one per input.
        card.addEventListener('change', (event) => {
          const target = event.target as HTMLElement;
          if (target.matches('[data-variant-select], [data-personalize-input]')) {
            syncPersonalizeCard(card);
          }
        });
      });

      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]');

      buttons.forEach((button) => {
        const defaultLabel = button.textContent ?? 'Add to Cart';

        button.addEventListener('click', () => {
          const card = button.closest('.product');
          let { priceId, name, price, image } = button.dataset;

          if (button.dataset.variantProduct !== undefined) {
            const select = card?.querySelector<HTMLSelectElement>('[data-variant-select]');
            const option = select?.selectedOptions[0];
            if (!select || !option) {
              console.error('Variant product is missing its option picker', button.dataset);
              return;
            }
            priceId = select.value;
            price = option.dataset.price;
            name = name ? `${name} — ${option.dataset.label}` : option.dataset.label;
          }

          // Collect + validate every currently-visible personalization field on this card.
          // reportValidity() shows the browser's native "fill this in" bubble and focuses the
          // field, so an empty required field stops the add right here.
          const visibleFields = card
            ? Array.from(card.querySelectorAll<HTMLElement>('[data-personalize-field]')).filter(
                (field) => !field.hidden,
              )
            : [];
          const noteParts: string[] = [];
          for (const field of visibleFields) {
            const input = field.querySelector<PersonalizeInput>('[data-personalize-input]');
            if (!input) continue;
            if (!input.reportValidity()) return;
            const value = input.value.trim();
            if (value) noteParts.push(`${input.dataset.personalizeLabel ?? ''}: ${value}`);
          }
          const note = noteParts.length > 0 ? noteParts.join('; ') : undefined;

          if (!priceId || !name || !price || !image) {
            // Missing data attributes mean the product is missing its Stripe Price ID
            // (see src/data/products.ts) — nothing to add, so leave the button alone.
            console.error('Add to Cart button is missing product data', button.dataset);
            return;
          }

          addItem({ priceId, name, price, image, note });

          // Clear personalization inputs so the next add-to-cart on this card starts blank
          // instead of silently reusing the last customer's name, then re-sync visibility and
          // swatches — clearing the Icon select back to blank should re-hide the custom-icon
          // field, and clearing Border Color should reset its swatch to the placeholder.
          for (const field of visibleFields) {
            const input = field.querySelector<PersonalizeInput>('[data-personalize-input]');
            if (input) input.value = '';
          }
          if (card) syncPersonalizeCard(card);

          // Brief confirmation in place of a toast component, matching the
          // relabel-on-submit pattern used on the custom order form.
          button.disabled = true;
          button.textContent = 'Added!';
          window.setTimeout(() => {
            button.disabled = false;
            button.textContent = defaultLabel;
          }, 1200);
        });
      });
    </script>

    <style>
      .intro {
        text-align: center;
      }
      .intro .lede {
        color: var(--peak);
        max-width: 600px;
        margin: 0 auto;
      }
      .custom-section {
        text-align: center;
      }
      .custom-section .lede {
        color: var(--peak);
        max-width: 600px;
        margin: 0 auto;
      }
      .custom-section .grid {
        text-align: left;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
      .product {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
      }
      .product img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0;
        display: block;
      }
      .product-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .product-body h3 {
        margin-bottom: 0.4em;
      }
      .description {
        color: var(--peak);
        font-size: 0.95rem;
        flex-grow: 1;
      }
      .personalize-fields {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
      }
      .personalize-field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        font-family: "Manrope", sans-serif;
      }
      .personalize-field .required {
        color: var(--rose);
      }
      .personalize-field input,
      .personalize-field select {
        width: 100%;
        padding: 0.55rem 0.65rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        box-sizing: border-box;
        font-family: inherit;
        font-size: 0.9rem;
        background: var(--card);
        color: var(--ink);
      }
      .personalize-field input:focus,
      .personalize-field select:focus {
        outline: 2px solid var(--violet);
        outline-offset: 1px;
      }
      .personalize-color-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .personalize-color-row select {
        flex: 1;
      }
      .personalize-swatch {
        flex-shrink: 0;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: repeating-linear-gradient(
          45deg,
          #f0f0f0,
          #f0f0f0 4px,
          #ffffff 4px,
          #ffffff 8px
        );
      }
      .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
      }
      .price {
        font-family: "Fraunces", serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--rose);
      }
      .variant-select {
        flex: 1;
        min-width: 0;
        padding: 0.5rem 0.6rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-family: "Manrope", sans-serif;
        font-size: 0.85rem;
        background: var(--card);
        color: var(--ink);
      }
      .variant-select:focus {
        outline: 2px solid var(--violet);
        outline-offset: 1px;
      }
      .buy-btn {
        padding: 0.6em 1.4em;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .quote-note {
        margin: 0.75rem 0 0 0;
        font-size: 0.8rem;
        color: var(--peak);
      }
    </style>
  </body>
</html>
