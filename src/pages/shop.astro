---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import { SITE_TITLE } from '../consts';
import { products } from '../data/products';

const mainProducts = products.filter((product) => product.category !== 'halloween');
const halloweenProducts = products.filter((product) => product.category === 'halloween');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Shop | ${SITE_TITLE}`}
      description="Ready-made embroidered goods you can order today, plus made-to-order pieces stitched with your own text."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section intro">
        <span class="eyebrow">Shop</span>
        <h1>Ready to order</h1>
        <p class="lede">
          Buy a finished piece as pictured, or design your own with the font and thread color of
          your choice. Looking for something else entirely? Start a
          <a href="/contact">custom order</a>.
        </p>
      </section>

      <StitchDivider />

      <section class="section">
        <div class="grid">
          {mainProducts.map((product) => (
            <div class="product">
              <img src={product.image} alt={product.name} />
              <div class="product-body">
                <h3>{product.name}</h3>
                <p class="description">{product.description}</p>
                {product.customOrderHref && (
                  <p class="quote-note">Quoted before you pay — no charge until you approve.</p>
                )}
                <div class="product-footer">
                  <span class="price">{product.price}</span>
                  {product.priceId ? (
                    <button
                      type="button"
                      class="btn btn-primary buy-btn add-to-cart-btn"
                      data-add-to-cart
                      data-price-id={product.priceId}
                      data-name={product.name}
                      data-price={product.price}
                      data-image={product.image}
                    >
                      {product.ctaLabel ?? 'Add to Cart'}
                    </button>
                  ) : (
                    <a href={product.customOrderHref} class="btn btn-primary buy-btn">
                      {product.ctaLabel ?? 'Design Yours'}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {halloweenProducts.length > 0 && (
        <>
          <StitchDivider />

          <section class="section halloween-section">
            <span class="eyebrow">Limited Time</span>
            <h2>🎃 Halloween Collection</h2>
            <p class="lede">
              Personalized trick-or-treat baskets, embroidered to order — get yours before the
              baskets start filling up.
            </p>
            <div class="grid">
              {halloweenProducts.map((product) => (
                <div class="product">
                  <img src={product.image} alt={product.name} />
                  <div class="product-body">
                    <h3>{product.name}</h3>
                    <p class="description">{product.description}</p>
                    <div class="product-footer">
                      <span class="price">{product.price}</span>
                      <button
                        type="button"
                        class="btn btn-primary buy-btn add-to-cart-btn"
                        data-add-to-cart
                        data-price-id={product.priceId}
                        data-name={product.name}
                        data-price={product.price}
                        data-image={product.image}
                      >
                        {product.ctaLabel ?? 'Add to Cart'}
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </>
      )}
    </main>
    <Footer />

    <script>
      import { addItem } from '../lib/cart';

      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]');

      buttons.forEach((button) => {
        const defaultLabel = button.textContent ?? 'Add to Cart';

        button.addEventListener('click', () => {
          const { priceId, name, price, image } = button.dataset;
          if (!priceId || !name || !price || !image) {
            // Missing data attributes mean the product is missing its Stripe Price ID
            // (see src/data/products.ts) — nothing to add, so leave the button alone.
            console.error('Add to Cart button is missing product data', button.dataset);
            return;
          }

          addItem({ priceId, name, price, image });

          // Brief confirmation in place of a toast component, matching the
          // relabel-on-submit pattern used on the custom order form.
          button.disabled = true;
          button.textContent = 'Added!';
          window.setTimeout(() => {
            button.disabled = false;
            button.textContent = defaultLabel;
          }, 1200);
        });
      });
    </script>

    <style>
      .intro {
        text-align: center;
      }
      .intro .lede {
        color: var(--peak);
        max-width: 600px;
        margin: 0 auto;
      }
      .halloween-section {
        text-align: center;
      }
      .halloween-section .lede {
        color: var(--peak);
        max-width: 600px;
        margin: 0 auto;
      }
      .halloween-section .grid {
        text-align: left;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
      .product {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
      }
      .product img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0;
        display: block;
      }
      .product-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .product-body h3 {
        margin-bottom: 0.4em;
      }
      .description {
        color: var(--peak);
        font-size: 0.95rem;
        flex-grow: 1;
      }
      .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
      }
      .price {
        font-family: "Fraunces", serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--rose);
      }
      .buy-btn {
        padding: 0.6em 1.4em;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .quote-note {
        margin: 0.75rem 0 0 0;
        font-size: 0.8rem;
        color: var(--peak);
      }
    </style>
  </body>
</html>
