---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchDivider from '../components/StitchDivider.astro';
import { SITE_TITLE } from '../consts';
import { products } from '../data/products';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Shop | ${SITE_TITLE}`}
      description="Ready-made embroidered goods you can order today, plus made-to-order pieces stitched with your own text."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section intro">
        <span class="eyebrow">Shop</span>
        <h1>Ready to order</h1>
        <p class="lede">
          Buy a finished piece as pictured, or design your own with the font and thread color of
          your choice. Looking for something else entirely? Start a
          <a href="/contact">custom order</a>.
        </p>
      </section>

      <StitchDivider />

      <section class="section">
        <div class="grid">
          {products.map((product) => (
            <div class="product">
              <img src={product.image} alt={product.name} />
              <div class="product-body">
                <h3>{product.name}</h3>
                <p class="description">{product.description}</p>
                {product.customOrderHref && (
                  <p class="quote-note">Quoted before you pay — no charge until you approve.</p>
                )}
                <div class="product-footer">
                  <span class="price">{product.price}</span>
                  {product.paymentLink ? (
                    <a href={product.paymentLink} class="btn btn-primary buy-btn">
                      {product.ctaLabel ?? 'Buy Now'}
                    </a>
                  ) : (
                    <a href={product.customOrderHref} class="btn btn-primary buy-btn">
                      {product.ctaLabel ?? 'Design Yours'}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
    <Footer />

    <style>
      .intro {
        text-align: center;
      }
      .intro .lede {
        color: var(--peak);
        max-width: 600px;
        margin: 0 auto;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
      .product {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
      }
      .product img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0;
        display: block;
      }
      .product-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
      }
      .product-body h3 {
        margin-bottom: 0.4em;
      }
      .description {
        color: var(--peak);
        font-size: 0.95rem;
        flex-grow: 1;
      }
      .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
      }
      .price {
        font-family: "Fraunces", serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--rose);
      }
      .buy-btn {
        padding: 0.6em 1.4em;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .quote-note {
        margin: 0.75rem 0 0 0;
        font-size: 0.8rem;
        color: var(--peak);
      }
    </style>
  </body>
</html>
